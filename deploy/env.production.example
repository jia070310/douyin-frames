# 复制为项目根目录 .env 后按需修改（可选；也可用系统环境变量）
NODE_ENV=production
HOST=127.0.0.1
PORT=3780
# 改成你的实际域名
ALLOWED_ORIGINS=https://frames.example.com,https://www.example.com,https://example.com
CLEANUP_AFTER_RELEASE_MIN=10
CLEANUP_TTL_HOURS=24
CLEANUP_MAX_MB=4096

# 抖音解析出口代理（机房 IP 必配；优先住宅/移动代理）
# 示例：
# DOUYIN_PROXY=http://user:pass@1.2.3.4:8080
# DOUYIN_PROXY=socks5://user:pass@1.2.3.4:1080
# DOUYIN_PROXY=http://1.2.3.4:7890
DOUYIN_PROXY=
