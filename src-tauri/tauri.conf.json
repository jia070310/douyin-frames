{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Douyin Frames",
  "version": "1.0.0",
  "identifier": "my.jinchan.douyinframes",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3780/boot.html",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "../public",
      "../src",
      "../package.json"
    ]
  },
  "plugins": {}
}
